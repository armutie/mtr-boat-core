<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>lidar_shm</transport_id>
      <type>SHM</type>
      <!-- Clouds approach 1 MB; the 512 KB default can lose full frames. -->
      <segment_size>8388608</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>lidar_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="lidar_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>lidar_shm</transport_id>
        <transport_id>lidar_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
