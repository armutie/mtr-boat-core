<?xml version="1.0"?>
<package format="3">
  <name>mtr_boat_core</name>
  <version>0.1.0</version>
  <description>ROS 2 sensor and navigation foundation for the MTR boat.</description>
  <maintainer email="user@example.com">mtr_radar</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>gstreamer1.0</exec_depend>
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pynmea2</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>seyond_mapping</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
